{
  "cli": {
    "version": ">= 14.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview-apk": {
      "distribution": "internal",
      "channel": "preview",
      "node": "20.18.1",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tea-achievements.onrender.com"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "production-aab": {
      "distribution": "store",
      "channel": "production",
      "node": "20.18.1",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tea-achievements.onrender.com"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production-aab": {}
  }
}
