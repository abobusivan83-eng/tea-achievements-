# URL бэкенда без завершающего слэша (как на сайте: VITE_API_URL).
# Пример: https://api.example.com
#
# При сборке тестового APK через EAS Build задайте то же самое на https://expo.dev
# (Project → Environment variables / Secrets) или:
#   npx eas-cli secret:create --name EXPO_PUBLIC_API_BASE_URL --value https://your-api.example.com ...
# На GitHub Actions: репозиторий → Secrets and variables → Actions:
#   EXPO_TOKEN                         (Expo Access Token)
#   EXPO_PUBLIC_API_BASE_URL           (HTTPS, без завершающего «/», напр. https://api.example.com)
#   EXPO_PUBLIC_STAGING_ACCESS_TOKEN   (опционально)
#
# Production APK: cleartext (HTTP) в нативной сети ОТКЛЮЧЕНО по умолчанию — используйте HTTPS API.
# Только если собираете dev/prebuild APK к LAN-серверу по http://:
#   EXPO_ANDROID_ALLOW_CLEARTEXT=true
#
EXPO_PUBLIC_API_BASE_URL=

# Опционально: если staging защищён заголовком (как VITE_STAGING_ACCESS_TOKEN на сайте).
EXPO_PUBLIC_STAGING_ACCESS_TOKEN=
