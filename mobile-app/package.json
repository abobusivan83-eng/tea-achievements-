{
  "name": "chai-achievements-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "eas:init": "npx eas-cli@latest init",
    "eas:whoami": "npx eas-cli@latest whoami",
    "build:apk:cloud": "node scripts/cloud-apk.cjs",
    "build:apk:cloud:submit": "node scripts/cloud-apk.cjs production-aab",
    "build:apk:local": "npx eas-cli@latest build --platform android --profile preview-apk --local --non-interactive"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av",
          "axios-retry"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "expo": "~52.0.25",
    "expo-av": "~15.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.4",
    "expo-font": "~13.0.4",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
